@using SFA.DAS.DigitalCertificates.Web.Controllers
@using SFA.DAS.DigitalCertificates.Web.ViewDataKeys
@{
    ViewData[ViewDataKeys.Title] = "Your session has expired";
    ViewBag.GaData.Vpv = "anti-forgery-your-session-has-expired";
}

<main class="govuk-main-wrapper " id="main-content" role="main">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl">We could not verify your session</h1>

            <p class="govuk-body">This may have happened because:</p>
            <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
                <li>your session has expired</li>
                <li>you have this service open in more than one tab</li>
            </ul>

            <p class="govuk-body">Try the following</p>
            <ul class="govuk-list govuk-list--bullet govuk-!-margin-left-2">
                <li>refresh this page</li>
                <li>sign out and sign in again</li>
                <li>close any other tabs open to this service and try again</li>
            </ul>

            <p class="govuk-body">You can contact us for support about your Apprenticeship certificates.</p>

            <h2 class="govuk-heading-m">Email</h2>
            <p class="govuk-body">
                <a href="mailto:helpdesk@manage-apprenticeships.service.gov.uk">helpdesk@manage-apprenticeships.service.gov.uk</a>
            </p>

            <h2 class="govuk-heading-m">Phone</h2>
            <p class="govuk-body">Phone: 0800 0150 600</p>
            <p class="govuk-body">Monday to Friday, 9am to 6pm</p>
            <p class="govuk-body">
                <a href="https://www.gov.uk/call-charges" target="_blank" title="Find out about call charges" rel="noopener noreferrer">Find out about call charges (opens in a new tab)</a>
            </p>
        </div>
    </div>
</main>
