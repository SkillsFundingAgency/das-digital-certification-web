@using Microsoft.Extensions.Options
@using SFA.DAS.DigitalCertificates.Infrastructure.Configuration
@using SFA.DAS.DigitalCertificates.Web.ViewDataKeys
@inject IOptions<DigitalCertificatesWebConfiguration> Config
@{
    ViewData[ViewDataKeys.Title] = $"You have successfully signed out of GOV.UK One Login";
    ViewBag.GaData.Vpv = "/service/signed-out";
}

<main class="govuk-main-wrapper" id="main-content">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">
                @ViewData[ViewDataKeys.Title]
            </h1>
        </div>
        <div class="govuk-grid-column-two-thirds">
            <p><a class="govuk-link" href="https://gov.uk/">Go to the GOV.UK homepage</a></p>
        </div>

    </div>
</main>